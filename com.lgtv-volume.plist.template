<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh fills in __NODE__ and __DIR__ and writes the result to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lgtv-volume</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__DIR__/dist/daemon.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__DIR__/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/daemon.log</string>
</dict>
</plist>
